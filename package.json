{
  "name": "second-brain-extraction-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "dev": "bun run db:up && bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "test:unit": "bun test",
    "typecheck": "tsc --noEmit",
    "fullcheck": "bun run lint && bun run typecheck && bun run test:unit",
    "prepare": "git config core.hooksPath .githooks",
    "lint": "biome check .",
    "format": "biome check --write .",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose stop postgres",
    "db:reset": "docker compose down postgres -v && bun run db:up",
    "db:migrate": "kysely migrate latest"
  },
  "dependencies": {
    "@elysiajs/openapi": "^1.4.15",
    "@sinclair/typebox": "^0.34.49",
    "ajv": "^8.20.0",
    "elysia": "^1.4.29",
    "kysely": "^0.29.2",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "uuidv7": "^1.2.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@types/bun": "^1.3.14",
    "@types/pg": "^8.20.0",
    "kysely-ctl": "^0.21.0",
    "pino-pretty": "^13.1.3",
    "typescript": "^6.0.3"
  }
}
